# DeployHub Environment Configuration

# Database (PostgreSQL)
DATABASE_URL=postgresql://deployhub:deployhub@localhost:5432/deployhub

# Cache / Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Security Keys
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
ENCRYPTION_KEY=change-me-to-32-byte-base64-encoded-key

# GitHub Integration (Phase 05)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Container Registry (Phase 02 / GHCR)
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=
REGISTRY_TOKEN=

# Kubernetes & Ingress (Phase 03)
BASE_DOMAIN=localtest.me
KUBECONFIG=~/.kube/config

# Deployment Engine Defaults
HOST_BIND_IP=127.0.0.1
DEFAULT_BUILD_TIMEOUT=600
DEFAULT_HEALTH_TIMEOUT=120
